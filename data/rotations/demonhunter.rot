# Demon Hunter: Havoc 577, Vengeance 581

spec 577 Havoc Demon Hunter
interrupt:
  Disrupt | target=casting_enemy
defensive:
  Blur | offgcd if self.hp < 50
  Netherwalk | offgcd if self.hp < 25
combat:
  Metamorphosis | offgcd if target.boss || target.elite || enemies >= 3
  Eye Beam | if target.distance < 20
  Blade Dance | if enemies >= 3
  Immolation Aura
  Chaos Strike | if self.fury >= 40
  Felblade | if self.fury <= 60
  Throw Glaive | if target.distance > 8
  Demon's Bite
utility:
  Consume Magic | target=dispellable_enemy.magic

spec 581 Vengeance Demon Hunter
interrupt:
  Disrupt | target=casting_enemy
defensive:
  Demon Spikes | offgcd if self.hp < 80 && !buff.Demon_Spikes
  Fiery Brand | offgcd if self.hp < 50
  Metamorphosis | offgcd if self.hp < 30
combat:
  Torment | target=loose_enemy
  Immolation Aura
  Sigil of Flame | if enemies >= 2
  Fracture | if self.fury <= 70
  Soul Cleave | if self.fury >= 30 && self.hp < 90
  Spirit Bomb | if enemies >= 2
  Throw Glaive | if target.distance > 8
  Shear
utility:
  Consume Magic | target=dispellable_enemy.magic
